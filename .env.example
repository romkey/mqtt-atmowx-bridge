# Copy to .env and fill in. Referenced from config.yaml as ${VAR}.

# --- atproto account ---------------------------------------------------------
# Your PDS, or the entryway you log in through. The bridge resolves your
# account's real PDS from your DID document and writes there.
ATP_SERVICE=https://bsky.social

# Handle, DID or email.
ATP_IDENTIFIER=station.example.com

# An app password from Settings -> App Passwords (xxxx-xxxx-xxxx-xxxx).
# Never your account password: an app password can be revoked on its own.
ATP_APP_PASSWORD=

# Where the session (access + refresh tokens) is cached between restarts.
ATP_SESSION_FILE=./data/session.json

# --- Your station ------------------------------------------------------------
# Printed by `mqtt-atmowx-bridge station create`.
STATION_URI=at://did:plc:youraccountdid/net.atmowx.station/3mremies2t222

# --- MQTT --------------------------------------------------------------------
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
